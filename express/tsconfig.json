{
    "extends": "@tsconfig/node18/tsconfig.json",
    "include": ["src"],
    "exclude": ["node_modules", "./**/dist"],
    "compilerOptions": {
        "resolveJsonModule": true,
        "declarationMap": true,
        "declaration": true,
        "rootDir": "./src",
        "target": "ES2022",
        "strict": true,
        "outDir": "./dist",
        "types": ["node"]
    }
}
