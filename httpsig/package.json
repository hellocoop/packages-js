{
    "name": "@hellocoop/httpsig",
    "version": "2.3.0",
    "description": "HTTP Message Signatures (RFC 9421) with Signature-Key header support",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hellocoop/packages-js.git"
    },
    "homepage": "https://github.com/hellocoop/packages-js/tree/main/httpsig",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./structured-fields": {
            "types": "./dist/types/structured-fields.d.ts",
            "import": "./dist/esm/structured-fields.js",
            "require": "./dist/cjs/structured-fields.js"
        }
    },
    "files": [
        "dist/",
        "src/vendor/"
    ],
    "keywords": [
        "http",
        "signature",
        "rfc9421",
        "httpsig",
        "message-signatures",
        "hwk",
        "jwt",
        "jwks_uri",
        "authentication"
    ],
    "author": {
        "name": "Hello Identity Co-op",
        "email": "contact@hello.coop",
        "url": "https://hello.coop"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/hellocoop/packages-js/issues"
    },
    "type": "module",
    "scripts": {
        "watch": "tsc --watch",
        "prebuild": "rimraf dist dist-test",
        "build": "npm run build:cjs && npm run build:esm && npm run build:types",
        "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/fixup-dist.cjs",
        "build:esm": "tsc -p tsconfig.esm.json",
        "build:types": "tsc -p tsconfig.types.json",
        "pretest": "tsc -p tsconfig.test.json",
        "test": "node --test --test-concurrency=1 dist-test/tests/test-*.js",
        "test:watch": "tsc -p tsconfig.test.json --watch & node --test --watch dist-test/tests/test-*.js"
    },
    "devDependencies": {
        "@misskey-dev/node-http-message-signatures": "^0.0.10",
        "@tsconfig/node18": "^18.2.2",
        "rimraf": "^5.0.1",
        "typescript": "^5.2.2"
    },
    "engines": {
        "node": ">=18"
    },
    "gitHead": "2708ae6a0cf0cb970bed968ab62955e639c9e897"
}
