        "url": "https://hello.coop"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/hellocoop/packages-js/issues"
    },
    "homepage": "https://www.hello.dev/docs/sdks/helper/",
    "devDependencies": {
        "@tsconfig/node18": "^18.2.7",
        "esbuild": "^0.28.2",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@hellocoop/definitions": "^1.0.13"
    },
